# ==============================================================================
# AutoPrompt Production & Local Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (or 'backend/.env' for local backend-only runs).
# 2. Populate your actual GEMINI_API_KEY.
# 3. NEVER commit the resulting '.env' file to version control.
# ==============================================================================

# ── 1. Google Gemini AI Provider (Required Secret) ───────────────────────────
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# In production, ensure Google Cloud billing is NOT enabled to prevent surprise costs.
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-3-flash-preview (or gemini-2.0-flash)
GEMINI_MODEL=gemini-3-flash-preview

# Model sampling temperature (0.0 to 1.0; 0.7 balances creativity with structural adherence)
GEMINI_TEMPERATURE=0.7

# Bounded API call timeout in seconds
GEMINI_TIMEOUT_SECONDS=30.0

# Maximum retries on transient errors (rate_limit, network, timeout) with exponential backoff
GEMINI_MAX_RETRIES=2

# ── 2. Application Runtime & Debug Controls ──────────────────────────────────
# IMPORTANT: In production, DEBUG MUST be false.
# When false:
# - Interactive API docs (/docs and /redoc) are disabled to prevent schema enumeration.
# - Detailed tracebacks are suppressed from API responses.
DEBUG=false

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── 3. Server Network Binding ────────────────────────────────────────────────
# Use 127.0.0.1 for local host execution, 0.0.0.0 inside Docker containers
HOST=0.0.0.0
PORT=8000

# ── 4. Persistent SQLite Database Storage ────────────────────────────────────
# In Docker Compose, maps to the persistent named volume at /app/data/autoprompt.db
# For local host development without Docker, use: sqlite:///./autoprompt.db
DATABASE_URL=sqlite:////app/data/autoprompt.db

# ── 5. Domain & SSL/TLS Configuration (Production Nginx & Certbot) ────────────
# Used by Nginx and Certbot for automated Let's Encrypt certificate issuance
DOMAIN_NAME=autoprompt.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
