# ==============================================================================
# AutoPrompt Backend Environment Configuration Template (backend/.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to 'backend/.env' (never commit backend/.env to Git).
# 2. Insert your Google Gemini API key.
# ==============================================================================

# ── Gemini Provider Settings (Required Secret) ───────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.7
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2

# ── Server & Runtime Environment ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── SQLite Database Storage ──────────────────────────────────────────────────
# Default local path (writes to backend/autoprompt.db)
DATABASE_URL=sqlite:///./autoprompt.db
